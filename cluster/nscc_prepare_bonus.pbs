#!/bin/bash
#PBS -q normal
#PBS -l select=1:ncpus=8:mem=32gb
#PBS -l walltime=02:00:00
#PBS -N kuairand-1k-prepare
#PBS -j oe

set -euo pipefail

cd "$PBS_O_WORKDIR"
module purge
module load pytorch/2.10.0-py3-cu12.6
NSCC_PYTORCH_SITE=/app/apps/pytorch/2.10.0-py3-cu12.6/lib/python3.13/site-packages
export PYTHONPATH="$PBS_O_WORKDIR/src:$NSCC_PYTORCH_SITE${PYTHONPATH:+:$PYTHONPATH}"

python -m research_rec.prepare_cli --data-root data/bonus_1k --variant 1k --download
