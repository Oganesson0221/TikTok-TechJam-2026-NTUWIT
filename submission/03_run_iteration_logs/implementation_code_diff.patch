+#!/usr/bin/env python3
+"""Train validation-selected FM feature ablations without reading test labels."""
+
+from __future__ import annotations
+
+import argparse
+import csv
+import json
+import pickle
+import sys
+import time
+from pathlib import Path
+
+import numpy as np
+
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "kuairand-starter-kit"))
+from baseline import FM  # noqa: E402
+from evaluate import evaluate  # noqa: E402
+
+
+USER_FIELDS = [
+    "follow_user_num_range", "register_days_range", "fans_user_num_range",
+    "friend_user_num_range", "user_active_degree",
+]
+VIDEO_FIELDS = ["author_id", "music_id", "video_type", "upload_type"]
+
+
+def read_map(path: Path, key: str, fields: list[str]) -> dict[str, list[str]]:
+    with path.open(newline="", encoding="utf-8") as handle:
+        return {row[key]: [row.get(field, "UNK") or "UNK" for field in fields] for row in csv.DictReader(handle)}
+
+
+def read_rows(data_dir: Path) -> dict[str, list[dict[str, str]]]:
+    output: dict[str, list[dict[str, str]]] = {"train": [], "valid": [], "test": []}
+    paths = [
+        data_dir / "log_standard_4_08_to_4_21_pure.csv",
+        data_dir / "log_standard_4_22_to_5_08_pure.csv",
+    ]
+    fields = ["user_id", "video_id", "tab", "duration_ms", "hourmin", "date", "long_view"]
+    for path in paths:
+        with path.open(newline="", encoding="utf-8") as handle:
+            for row in csv.DictReader(handle):
+                date = int(row["date"])
+                split = "train" if date <= 20220421 else "valid" if date <= 20220428 else "test"
+                # Test outcomes are deliberately dropped at ingestion.
+                record = {field: row[field] for field in fields if field != "long_view" or split != "test"}
+                output[split].append(record)
+    return output
+
+
+def encode(
+    rows: dict[str, list[dict[str, str]]],
+    user_features: dict[str, list[str]],
+    video_features: dict[str, list[str]],
+    mode: str,
+) -> tuple[dict[str, tuple[np.ndarray, np.ndarray | None, np.ndarray]], int, list[dict[str, int]], np.ndarray]:
+    durations = np.array([float(row["duration_ms"]) for row in rows["train"]])
+    edges = np.quantile(durations, np.linspace(0, 1, 11)[1:-1])
+
+    def raw(row: dict[str, str]) -> list[str]:
+        video = video_features.get(row["video_id"], ["UNK"] * len(VIDEO_FIELDS))
+        user = user_features.get(row["user_id"], ["UNK"] * len(USER_FIELDS))
+        values = [
+            row["user_id"], row["video_id"], video[0], row["tab"],
+            str(int(np.searchsorted(edges, float(row["duration_ms"])))),
+        ]
+        if mode in {"item", "full", "full_context"}:
+            values += video[1:]
+        if mode in {"full", "full_context"}:
+            values += user
+        if mode == "full_context":
+            values += [str(min(23, max(0, int(row["hourmin"]) // 100))), str(int(row["date"]) % 7)]
+        return values
+
+    field_count = len(raw(rows["train"][0]))
+    vocabs: list[dict[str, int]] = [dict() for _ in range(field_count)]
+    for row in rows["train"]:
+        for index, value in enumerate(raw(row)):
+            if value not in vocabs[index]:
+                vocabs[index][value] = len(vocabs[index])
+    unknown = [len(vocab) for vocab in vocabs]
+    dimensions = [len(vocab) + 1 for vocab in vocabs]
+    offsets = np.cumsum([0, *dimensions[:-1]]).astype(np.int32)
+    encoded = {}
+    for split, split_rows in rows.items():
+        features = np.empty((len(split_rows), field_count), dtype=np.int32)
+        users = np.empty(len(split_rows), dtype=np.int32)
+        labels = None if split == "test" else np.empty(len(split_rows), dtype=np.float32)
+        for row_index, row in enumerate(split_rows):
+            users[row_index] = int(row["user_id"])
+            for field_index, value in enumerate(raw(row)):
+                features[row_index, field_index] = vocabs[field_index].get(value, unknown[field_index]) + offsets[field_index]
+            if labels is not None:
+                labels[row_index] = 1.0 if row["long_view"] != "0" else 0.0
+        encoded[split] = (features, labels, users)
+    return encoded, int(sum(dimensions)), vocabs, edges
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--data-dir", type=Path, default=ROOT / "data/raw/KuaiRand-Pure/data")
+    parser.add_argument("--mode", choices=["base", "item", "full", "full_context"], required=True)
+    parser.add_argument("--seed", type=int, default=0)
+    parser.add_argument("--epochs", type=int, default=40)
+    args = parser.parse_args()
+    started = time.perf_counter()
+    rows = read_rows(args.data_dir)
+    users = read_map(args.data_dir / "user_features_pure.csv", "user_id", USER_FIELDS)
+    videos = read_map(args.data_dir / "video_features_basic_pure.csv", "video_id", VIDEO_FIELDS)
+    encoded, dimension, vocabs, edges = encode(rows, users, videos, args.mode)
+    x_train, y_train, _ = encoded["train"]
+    x_valid, y_valid, u_valid = encoded["valid"]
+    x_test, _, _ = encoded["test"]
+    assert y_train is not None and y_valid is not None
+    model = FM(dimension, k=16, lr=0.001, seed=args.seed)
+    rng = np.random.default_rng(args.seed)
+    best_primary = -1.0
+    best_state = None
+    history = []
+    bad = 0
+    batch_size = 8192
+    for epoch in range(1, args.epochs + 1):
+        order = rng.permutation(len(y_train))
+        losses = [model.step(x_train[order[i:i + batch_size]], y_train[order[i:i + batch_size]]) for i in range(0, len(order), batch_size)]
+        metrics = {key: float(value) for key, value in evaluate(u_valid, y_valid, model.predict(x_valid)).items()}
+        history.append({"epoch": epoch, "loss": float(np.mean(losses)), **metrics})
+        print(json.dumps(history[-1]), flush=True)
+        if metrics["primary"] > best_primary + 1e-5:
+            best_primary = metrics["primary"]
+            best_state = (model.V.copy(), model.W.copy(), np.float32(model.b))
+            bad = 0
+        else:
+            bad += 1
+            if bad >= 4:
+                break
+    assert best_state is not None
+    model.V, model.W, model.b = best_state
+    valid_scores = model.predict(x_valid)
+    test_scores = model.predict(x_test)
+    metrics = {key: float(value) for key, value in evaluate(u_valid, y_valid, valid_scores).items()}
+    out_dir = ROOT / f"artifacts/official_side_fm/{args.mode}_seed{args.seed}"
+    out_dir.mkdir(parents=True, exist_ok=True)
+    with (out_dir / "model.pkl").open("wb") as handle:
+        pickle.dump({"V": model.V, "W": model.W, "b": model.b, "mode": args.mode, "vocabs": vocabs, "edges": edges}, handle)
+    for split, scores in (("valid", valid_scores), ("test", test_scores)):
+        output = out_dir / f"{split}.csv"
+        with output.open("w", newline="", encoding="utf-8") as handle:
+            writer = csv.writer(handle)
+            writer.writerow(["row_id", "user_id", "video_id", "score"])
+            for row_id, (row, score) in enumerate(zip(rows[split], scores, strict=True)):
+                writer.writerow([row_id, row["user_id"], row["video_id"], f"{float(score):.8g}"])
+    summary = {
+        "status": "completed", "mode": args.mode, "seed": args.seed,
+        "hypothesis": "Additional train-known side/context fields improve long-view ordering beyond the five-field FM.",
+        "validation_metrics": metrics, "history": history,
+        "elapsed_seconds": time.perf_counter() - started,
+        "test_labels_read": False, "manual_interventions": 0,
+    }
+    (out_dir / "summary.json").write_text(json.dumps(summary, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps(summary, indent=2), flush=True)
+
+
+if __name__ == "__main__":
+    main()

