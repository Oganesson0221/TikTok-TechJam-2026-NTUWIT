+#!/usr/bin/env python3
+"""Reproduce the official FM, then fine-tune it with within-user BPR.
+
+The test CSV is loaded with user/item/context columns only. Test long_view is
+never requested, evaluated, or used for model selection.
+"""
+
+from __future__ import annotations
+
+import argparse
+import csv
+import json
+import os
+import pickle
+import sys
+import time
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+
+
+ROOT = Path(__file__).resolve().parents[1]
+KIT = ROOT / "kuairand-starter-kit"
+sys.path.insert(0, str(KIT))
+import baseline as starter_baseline  # noqa: E402
+import data as starter_data  # noqa: E402
+
+sys.path.insert(0, str(ROOT / "src"))
+from research_rec.metrics import official_ranking_metrics  # noqa: E402
+
+
+def load_rows(path: str | Path, authors: dict[str, str], include_label: bool) -> list[tuple]:
+    columns = ["date", "user_id", "video_id", "tab", "duration_ms"]
+    if include_label:
+        columns.append("long_view")
+    frame = pd.read_csv(path, usecols=columns)
+    rows = []
+    labels = frame["long_view"].to_numpy() if include_label else np.zeros(len(frame), dtype=np.int8)
+    for date, user, video, tab, duration, label in zip(
+        frame["date"].to_numpy(),
+        frame["user_id"].astype(str).to_numpy(),
+        frame["video_id"].astype(str).to_numpy(),
+        frame["tab"].astype(str).to_numpy(),
+        frame["duration_ms"].to_numpy(),
+        labels,
+        strict=True,
+    ):
+        rows.append((int(date), user, video, authors.get(video, "UNK"), tab, float(duration), int(label != 0)))
+    return rows
+
+
+def bpr_step(model: starter_baseline.FM, positive: np.ndarray, negative: np.ndarray) -> float:
+    zp, ep, sp = model.logits(positive)
+    zn, en, sn = model.logits(negative)
+    difference = zp - zn
+    loss = np.logaddexp(0.0, -difference)
+    gradient = (-starter_baseline.sigmoid(-difference) / len(difference)).astype(np.float32)
+    grad_v = np.zeros_like(model.V)
+    grad_w = np.zeros_like(model.W)
+    np.add.at(grad_w, positive, gradient[:, None])
+    np.add.at(grad_w, negative, -gradient[:, None])
+    np.add.at(grad_v, positive, gradient[:, None, None] * (sp[:, None, :] - ep))
+    np.add.at(grad_v, negative, -gradient[:, None, None] * (sn[:, None, :] - en))
+    grad_v += model.l2 * model.V
+    grad_w += model.l2 * model.W
+    model.t += 1
+    beta1, beta2, epsilon = 0.9, 0.999, 1e-8
+    for parameter, grad, first, second in (
+        (model.V, grad_v, model.mV, model.vV),
+        (model.W, grad_w, model.mW, model.vW),
+    ):
+        first *= beta1
+        first += (1 - beta1) * grad
+        second *= beta2
+        second += (1 - beta2) * (grad * grad)
+        parameter -= model.lr * (first / (1 - beta1**model.t)) / (
+            np.sqrt(second / (1 - beta2**model.t)) + epsilon
+        )
+    return float(loss.mean())
+
+
+def make_pairs(users: np.ndarray, labels: np.ndarray, negatives_per_positive: int, seed: int) -> tuple[np.ndarray, np.ndarray]:
+    rng = np.random.default_rng(seed)
+    order = np.argsort(users, kind="stable")
+    sorted_users = users[order]
+    boundaries = np.flatnonzero(sorted_users[1:] != sorted_users[:-1]) + 1
+    positives: list[np.ndarray] = []
+    negatives: list[np.ndarray] = []
+    for indices in np.split(order, boundaries):
+        pos = indices[labels[indices] == 1]
+        neg = indices[labels[indices] == 0]
+        if len(pos) == 0 or len(neg) == 0:
+            continue
+        positives.append(np.repeat(pos, negatives_per_positive))
+        negatives.append(rng.choice(neg, size=len(pos) * negatives_per_positive, replace=True))
+    return np.concatenate(positives), np.concatenate(negatives)
+
+
+def write_submission(path: Path, rows: list[tuple], scores: np.ndarray) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    temporary = path.with_suffix(path.suffix + ".tmp")
+    with temporary.open("w", newline="", encoding="utf-8") as handle:
+        writer = csv.writer(handle)
+        writer.writerow(["row_id", "user_id", "video_id", "score"])
+        for row_id, (row, score) in enumerate(zip(rows, scores, strict=True)):
+            writer.writerow((row_id, row[1], row[2], f"{float(score):.8g}"))
+    os.replace(temporary, path)
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--train-csv", default="data/official_pure/train.csv")
+    parser.add_argument("--validation-csv", default="data/official_pure/validation.csv")
+    parser.add_argument("--test-csv", default="data/official_pure/test.csv")
+    parser.add_argument("--video-features", default="data/raw/KuaiRand-Pure/data/video_features_basic_pure.csv")
+    parser.add_argument("--bpr-epochs", type=int, default=6)
+    parser.add_argument("--bpr-lr", type=float, default=0.0002)
+    parser.add_argument("--pairs", type=int, default=2)
+    parser.add_argument("--batch-size", type=int, default=8192)
+    parser.add_argument("--seed", type=int, default=0)
+    parser.add_argument("--checkpoint", default="artifacts/official_checkpoints/official_pure_fm_bpr/model.pkl")
+    parser.add_argument("--submission", default="artifacts/official_submissions/kuairand_pure_fm_bpr.csv")
+    parser.add_argument("--validation-output", default="artifacts/official_submissions/kuairand_pure_fm_valid.csv")
+    parser.add_argument("--log", default="artifacts/official_pure_fm_bpr/iterations.jsonl")
+    args = parser.parse_args()
+    started = time.perf_counter()
+    authors: dict[str, str] = {}
+    with Path(args.video_features).open() as handle:
+        for row in csv.DictReader(handle):
+            authors[row["video_id"]] = row["author_id"]
+    splits = {
+        "train": load_rows(args.train_csv, authors, True),
+        "valid": load_rows(args.validation_csv, authors, True),
+        "test": load_rows(args.test_csv, authors, False),
+    }
+    encoded, dimension = starter_data.encode(splits)
+    x_train, y_train, train_users = encoded["train"]
+    x_valid, y_valid, valid_users = encoded["valid"]
+    x_test, _, _ = encoded["test"]
+    model = starter_baseline.FM(dimension, k=16, lr=0.001, seed=args.seed)
+    rng = np.random.default_rng(args.seed)
+    best_primary = float("-inf")
+    best_state = None
+    bad = 0
+    records: list[dict] = []
+    for epoch in range(1, 41):
+        indices = rng.permutation(len(y_train))
+        losses = [
+            model.step(x_train[indices[start : start + args.batch_size]], y_train[indices[start : start + args.batch_size]])
+            for start in range(0, len(indices), args.batch_size)
+        ]
+        metrics = official_ranking_metrics(np.asarray(valid_users), y_valid, model.predict(x_valid))
+        if metrics["primary"] > best_primary + 1e-5:
+            best_primary = metrics["primary"]
+            best_state = (model.V.copy(), model.W.copy(), np.float32(model.b))
+            bad = 0
+        else:
+            bad += 1
+        if bad >= 4:
+            break
+    model.V, model.W, model.b = best_state
+    baseline_metrics = official_ranking_metrics(np.asarray(valid_users), y_valid, model.predict(x_valid))
+    records.append(
+        {
+            "iteration": 1,
+            "hypothesis": "Reproduce the organizer five-field FM baseline before changing the loss.",
+            "code_diff": "No algorithmic diff; exact Starter Kit FM configuration.",
+            "metrics": baseline_metrics,
+            "errors": [],
+            "recoveries": [],
+            "manual_interventions": 0,
+        }
+    )
+    positive_indices, negative_indices = make_pairs(
+        np.asarray(train_users), y_train, args.pairs, args.seed
+    )
+    model.lr = args.bpr_lr
+    best_state = (model.V.copy(), model.W.copy(), np.float32(model.b))
+    best_metrics = baseline_metrics
+    for bpr_epoch in range(1, args.bpr_epochs + 1):
+        permutation = rng.permutation(len(positive_indices))
+        losses = []
+        for start in range(0, len(permutation), args.batch_size):
+            batch = permutation[start : start + args.batch_size]
+            losses.append(bpr_step(model, x_train[positive_indices[batch]], x_train[negative_indices[batch]]))
+        metrics = official_ranking_metrics(np.asarray(valid_users), y_valid, model.predict(x_valid))
+        records.append(
+            {
+                "iteration": bpr_epoch + 1,
+                "hypothesis": "Within-user BPR should align the official FM with GAUC and nDCG@5.",
+                "code_diff": {"loss": "pointwise_logloss -> BPR", "learning_rate": args.bpr_lr, "pairs": args.pairs},
+                "metrics": metrics,
+                "train_loss": float(np.mean(losses)),
+                "errors": [],
+                "recoveries": [],
+                "manual_interventions": 0,
+            }
+        )
+        if metrics["primary"] > best_metrics["primary"]:
+            best_metrics = metrics
+            best_state = (model.V.copy(), model.W.copy(), np.float32(model.b))
+    model.V, model.W, model.b = best_state
+    checkpoint = Path(args.checkpoint)
+    checkpoint.parent.mkdir(parents=True, exist_ok=True)
+    with checkpoint.open("wb") as handle:
+        pickle.dump(
+            {
+                "V": model.V,
+                "W": model.W,
+                "b": model.b,
+                "feature_contract": starter_data.FIELDS,
+                "encoder_rebuild": "Deterministic from official train split via kuairand-starter-kit/data.py::encode",
+                "validation_metrics": best_metrics,
+                "test_labels_read": False,
+            },
+            handle,
+        )
+    submission = Path(args.submission)
+    write_submission(Path(args.validation_output), splits["valid"], model.predict(x_valid))
+    write_submission(submission, splits["test"], model.predict(x_test))
+    log_path = Path(args.log)
+    log_path.parent.mkdir(parents=True, exist_ok=True)
+    log_path.write_text("".join(json.dumps(record) + "\n" for record in records), encoding="utf-8")
+    summary = {
+        "status": "completed",
+        "best_validation_metrics": best_metrics,
+        "official_validation_baseline": {"GAUC": 0.6674, "nDCG@5": 0.5357, "primary": 0.6016},
+        "iterations": len(records),
+        "elapsed_seconds": time.perf_counter() - started,
+        "checkpoint": str(checkpoint.resolve()),
+        "submission": str(submission.resolve()),
+        "test_labels_read": False,
+        "manual_interventions": 0,
+    }
+    (log_path.parent / "summary.json").write_text(json.dumps(summary, indent=2), encoding="utf-8")
+    print(json.dumps(summary, indent=2))
+
+
+if __name__ == "__main__":
+    main()

