diff --git a/scripts/nscc_configure.sh b/scripts/nscc_configure.sh
new file mode 100755
index 0000000..bb6e30a
--- /dev/null
+++ b/scripts/nscc_configure.sh
@@ -0,0 +1,34 @@
+#!/bin/bash
+
+set -euo pipefail
+SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
+# shellcheck source=nscc_common.sh
+source "$SCRIPT_DIR/nscc_common.sh"
+nscc_require_socket
+
+LOCAL_ENV="$NSCC_REPO_ROOT/.env"
+# Prevent a caller's `bash -x` from exposing values while the secret file is
+# sourced or streamed. Re-enable tracing nowhere in this script.
+set +x
+if [[ -f "$LOCAL_ENV" ]]; then
+  set -a
+  # shellcheck disable=SC1090
+  source "$LOCAL_ENV"
+  set +a
+fi
+if [[ -z "${OPENAI_API_KEY:-}" ]]; then
+  echo "OPENAI_API_KEY is not set locally or in $LOCAL_ENV; NSCC login works, but OpenAI policy jobs will not." >&2
+  exit 2
+fi
+
+# The secret travels only over encrypted stdin. It never appears in argv,
+# terminal output, rsync content, or tracked repository files.
+{
+  printf 'export OPENAI_API_KEY=%q\n' "$OPENAI_API_KEY"
+  if [[ -n "${OPENAI_MODEL:-}" ]]; then
+    printf 'export OPENAI_MODEL=%q\n' "$OPENAI_MODEL"
+  fi
+} | ssh -S "$NSCC_SOCKET" "$NSCC_TARGET" "umask 077; mkdir -p '$NSCC_REMOTE_DIR/.nscc-secrets'; cat > '$NSCC_REMOTE_DIR/.nscc-secrets/openai.env'; chmod 600 '$NSCC_REMOTE_DIR/.nscc-secrets/openai.env'"
+
+ssh -S "$NSCC_SOCKET" "$NSCC_TARGET" "test -s '$NSCC_REMOTE_DIR/.nscc-secrets/openai.env' && test \"\$(stat -c %a '$NSCC_REMOTE_DIR/.nscc-secrets/openai.env')\" = 600"
+echo "Remote OpenAI environment configured securely (value not displayed)."

