@@ -0,0 +1,64 @@
+#!/usr/bin/env python3
+"""Build an aligned weighted ensemble in the exact official schema."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+
+
+def parse_component(value: str) -> tuple[str, float, Path]:
+    try:
+        name, weight, path = value.split("=", 2)
+        return name, float(weight), Path(path)
+    except ValueError as error:
+        raise argparse.ArgumentTypeError("component must be NAME=WEIGHT=CSV") from error
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--component", action="append", type=parse_component, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    expected = ["row_id", "user_id", "video_id", "score"]
+    total_weight = sum(weight for _, weight, _ in args.component)
+    if not np.isclose(total_weight, 1.0):
+        raise ValueError(f"component weights must sum to one, got {total_weight}")
+    reference = None
+    output_scores = None
+    recipe = []
+    for name, weight, path in args.component:
+        frame = pd.read_csv(path)
+        if list(frame.columns) != expected:
+            raise ValueError(f"{path} does not have exact schema {expected}")
+        if reference is None:
+            reference = frame.iloc[:, :3].copy()
+            output_scores = np.zeros(len(frame), dtype=np.float64)
+        elif not reference.equals(frame.iloc[:, :3]):
+            raise ValueError(f"{path} identifiers are not aligned")
+        assert output_scores is not None
+        output_scores += weight * frame["score"].to_numpy(dtype=np.float64)
+        recipe.append({"name": name, "weight": weight, "source": str(path)})
+    assert reference is not None and output_scores is not None
+    reference["score"] = output_scores
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    reference.to_csv(args.output, index=False)
+    metadata = {
+        "method": "validation_selected_raw_score_weighted_ensemble",
+        "components": recipe,
+        "rows": len(reference),
+        "schema": expected,
+        "test_outcome_columns_read": [],
+    }
+    args.output.with_suffix(args.output.suffix + ".meta.json").write_text(
+        json.dumps(metadata, indent=2) + "\n", encoding="utf-8"
+    )
+    print(json.dumps({"output": str(args.output), **metadata}, indent=2))
+
+
+if __name__ == "__main__":
+    main()

