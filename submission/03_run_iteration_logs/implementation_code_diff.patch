+import csv
+
+from research_rec.official_data import prepare_official_splits
+
+
+HEADER = ["user_id", "video_id", "date", "long_view"]
+
+
+def _write(path, rows):
+    with path.open("w", newline="") as handle:
+        writer = csv.writer(handle)
+        writer.writerow(HEADER)
+        writer.writerows(rows)
+
+
+def test_prepare_official_splits_filters_dates_and_preserves_order(tmp_path):
+    source = tmp_path / "raw"
+    source.mkdir()
+    _write(source / "log_standard_4_08_to_4_21_pure.csv", [[1, 9, 20220407, 1], [1, 8, 20220408, 0]])
+    _write(
+        source / "log_standard_4_22_to_5_08_pure.csv",
+        [[2, 7, 20220429, 1], [2, 6, 20220422, 0], [3, 5, 20220508, 1]],
+    )
+    manifest = prepare_official_splits(source, tmp_path / "prepared", "pure")
+    assert manifest["splits"]["train"]["rows"] == 1
+    assert manifest["splits"]["validation"]["rows"] == 1
+    assert manifest["splits"]["test"]["rows"] == 2
+    with (tmp_path / "prepared" / "test.csv").open() as handle:
+        rows = list(csv.DictReader(handle))
+    assert [row["video_id"] for row in rows] == ["7", "5"]

