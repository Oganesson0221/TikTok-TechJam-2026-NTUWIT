+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+import pickle
+import time
+from pathlib import Path
+from typing import Any
+
+import lightgbm as lgb
+import numpy as np
+import pandas as pd
+
+from .metrics import official_ranking_metrics
+from .official_submit import OFFICIAL_HEADER, validate_official_submission
+
+
+RAW_COLUMNS = ["user_id", "video_id", "date", "hourmin", "duration_ms", "tab", "long_view"]
+MODEL_COLUMNS = [
+    "user_id",
+    "video_id",
+    "author_id",
+    "tab",
+    "duration_bucket",
+    "hour",
+    "weekday",
+    "item_long_view_rate",
+    "author_long_view_rate",
+    "user_author_long_view_rate",
+    "user_duration_long_view_rate",
+]
+CATEGORICAL_COLUMNS = ["user_id", "video_id", "author_id", "tab", "duration_bucket", "hour", "weekday"]
+
+
+def _read_interactions(path: str | Path, include_label: bool) -> pd.DataFrame:
+    columns = RAW_COLUMNS if include_label else [column for column in RAW_COLUMNS if column != "long_view"]
+    frame = pd.read_csv(path, usecols=columns)
+    frame["_row_order"] = np.arange(len(frame), dtype=np.int64)
+    return frame
+
+
+def _prepare_context(frame: pd.DataFrame, video_features: pd.DataFrame) -> pd.DataFrame:
+    result = frame.merge(video_features, on="video_id", how="left", validate="many_to_one", sort=False)
+    result = result.sort_values("_row_order", kind="stable")
+    result["author_id"] = result["author_id"].fillna(-1).astype(np.int64)
+    duration = pd.to_numeric(result["duration_ms"], errors="coerce").fillna(0).to_numpy()
+    result["duration_bucket"] = np.minimum(np.log2(np.maximum(duration, 0) / 1000.0 + 1).astype(int), 31)
+    hourmin = pd.to_numeric(result["hourmin"], errors="coerce").fillna(0).astype(np.int64)
+    result["hour"] = (hourmin // 100).clip(0, 23)
+    dates = pd.to_datetime(result["date"].astype(str), format="%Y%m%d")
+    result["weekday"] = dates.dt.dayofweek.astype(np.int64)
+    result["tab"] = pd.to_numeric(result["tab"], errors="coerce").fillna(0).astype(np.int64)
+    return result
+
+
+def _rate_table(train: pd.DataFrame, keys: list[str], prefix: str) -> pd.DataFrame:
+    table = train.groupby(keys, sort=False)["long_view"].agg(["sum", "count"]).reset_index()
+    return table.rename(columns={"sum": f"{prefix}_sum", "count": f"{prefix}_count"})
+
+
+def _fit_statistics(train: pd.DataFrame) -> dict[str, Any]:
+    return {
+        "global_rate": float(train["long_view"].mean()),
+        "item": _rate_table(train, ["video_id"], "item"),
+        "author": _rate_table(train, ["author_id"], "author"),
+        "user_author": _rate_table(train, ["user_id", "author_id"], "user_author"),
+        "user_duration": _rate_table(train, ["user_id", "duration_bucket"], "user_duration"),
+    }
+
+
+def _attach_rate(
+    frame: pd.DataFrame,
+    table: pd.DataFrame,
+    keys: list[str],
+    prefix: str,
+    prior: float,
+    global_rate: float,
+    leave_one_out: bool,
+) -> pd.DataFrame:
+    result = frame.merge(table, on=keys, how="left", validate="many_to_one", sort=False)
+    sums = result[f"{prefix}_sum"].fillna(0).to_numpy(dtype=np.float64)
+    counts = result[f"{prefix}_count"].fillna(0).to_numpy(dtype=np.float64)
+    if leave_one_out:
+        labels = result["long_view"].to_numpy(dtype=np.float64)
+        sums -= labels
+        counts -= 1.0
+    result[f"{prefix}_long_view_rate"] = (sums + prior * global_rate) / (counts + prior)
+    return result.drop(columns=[f"{prefix}_sum", f"{prefix}_count"])
+
+
+def _build_features(frame: pd.DataFrame, stats: dict[str, Any], leave_one_out: bool) -> pd.DataFrame:
+    global_rate = stats["global_rate"]
+    result = _attach_rate(frame, stats["item"], ["video_id"], "item", 20.0, global_rate, leave_one_out)
+    result = _attach_rate(result, stats["author"], ["author_id"], "author", 50.0, global_rate, leave_one_out)
+    result = _attach_rate(
+        result, stats["user_author"], ["user_id", "author_id"], "user_author", 10.0, global_rate, leave_one_out
+    )
+    result = _attach_rate(
+        result,
+        stats["user_duration"],
+        ["user_id", "duration_bucket"],
+        "user_duration",
+        10.0,
+        global_rate,
+        leave_one_out,
+    )
+    return result[MODEL_COLUMNS]
+
+
+def _groups(users: pd.Series) -> np.ndarray:
+    values = users.to_numpy()
+    if np.any(values[1:] < values[:-1]):
+        raise ValueError("Official LambdaRank input must remain sorted by user_id")
+    return users.groupby(users, sort=False).size().to_numpy(dtype=np.int32)
+
+
+def _sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for block in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def run(args: argparse.Namespace) -> dict[str, Any]:
+    started = time.perf_counter()
+    video_features = pd.read_csv(args.video_features, usecols=["video_id", "author_id"])
+    train = _prepare_context(_read_interactions(args.train_csv, True), video_features)
+    validation = _prepare_context(_read_interactions(args.validation_csv, True), video_features)
+    stats = _fit_statistics(train)
+    train_ranked = train.sort_values(["user_id", "_row_order"], kind="stable").reset_index(drop=True)
+    validation_ranked = validation.sort_values(["user_id", "_row_order"], kind="stable").reset_index(drop=True)
+    train_features = _build_features(train_ranked, stats, leave_one_out=True)
+    validation_features = _build_features(validation_ranked, stats, leave_one_out=False)
+    train_set = lgb.Dataset(
+        train_features,
+        label=train_ranked["long_view"].to_numpy(dtype=np.int8),
+        group=_groups(train_ranked["user_id"]),
+        categorical_feature=CATEGORICAL_COLUMNS,
+        free_raw_data=False,
+    )
+    validation_set = lgb.Dataset(
+        validation_features,
+        label=validation_ranked["long_view"].to_numpy(dtype=np.int8),
+        group=_groups(validation_ranked["user_id"]),
+        categorical_feature=CATEGORICAL_COLUMNS,
+        reference=train_set,
+        free_raw_data=False,
+    )
+    params = {
+        "objective": "lambdarank",
+        "metric": "ndcg",
+        "ndcg_eval_at": [5],
+        "label_gain": [0, 1],
+        "learning_rate": args.learning_rate,
+        "num_leaves": args.num_leaves,
+        "min_data_in_leaf": 100,
+        "feature_fraction": 0.9,
+        "bagging_fraction": 0.9,
+        "bagging_freq": 1,
+        "lambda_l2": 1e-4,
+        "seed": args.seed,
+        "num_threads": args.num_threads,
+        "verbosity": -1,
+    }
+    booster = lgb.train(
+        params,
+        train_set,
+        num_boost_round=args.rounds,
+        valid_sets=[validation_set],
+        valid_names=["validation"],
+        callbacks=[lgb.early_stopping(args.patience), lgb.log_evaluation(10)],
+    )
+    validation_scores = booster.predict(validation_features, num_iteration=booster.best_iteration)
+    metrics = official_ranking_metrics(
+        validation_ranked["user_id"].to_numpy(),
+        validation_ranked["long_view"].to_numpy(),
+        validation_scores,
+    )
+
+    checkpoint = Path(args.checkpoint)
+    checkpoint.parent.mkdir(parents=True, exist_ok=True)
+    temporary_checkpoint = checkpoint.with_suffix(checkpoint.suffix + ".tmp")
+    with temporary_checkpoint.open("wb") as handle:
+        pickle.dump({"booster": booster, "statistics": stats, "model_columns": MODEL_COLUMNS}, handle)
+    os.replace(temporary_checkpoint, checkpoint)
+
+    test = _prepare_context(_read_interactions(args.test_csv, False), video_features)
+    test_features = _build_features(test, stats, leave_one_out=False)
+    test_scores = booster.predict(test_features, num_iteration=booster.best_iteration)
+    if not np.isfinite(test_scores).all():
+        raise ValueError("LambdaRank produced NaN or Inf test scores")
+    submission = Path(args.submission)
+    submission.parent.mkdir(parents=True, exist_ok=True)
+    temporary_submission = submission.with_suffix(submission.suffix + ".tmp")
+    pd.DataFrame(
+        {
+            "row_id": np.arange(len(test), dtype=np.int64),
+            "user_id": test["user_id"].to_numpy(),
+            "video_id": test["video_id"].to_numpy(),
+            "score": test_scores,
+        }
+    ).to_csv(temporary_submission, index=False, columns=OFFICIAL_HEADER)
+    os.replace(temporary_submission, submission)
+    validation_result = validate_official_submission(submission, args.test_csv)
+    elapsed = time.perf_counter() - started
+    result = {
+        "status": "completed",
+        "benchmark": "KuaiRand-Pure",
+        "hypothesis": "LambdaRank plus train-only user-history aggregates aligns optimization with GAUC/nDCG@5 and adds missing sequential preference signal.",
+        "validation_metrics": metrics,
+        "official_fm_validation": {"GAUC": 0.6674, "nDCG@5": 0.5357, "primary": 0.6016},
+        "validation_delta_over_official_fm": {
+            "GAUC": metrics["GAUC"] - 0.6674,
+            "nDCG@5": metrics["nDCG@5"] - 0.5357,
+            "primary": metrics["primary"] - 0.6016,
+        },
+        "best_iteration": booster.best_iteration,
+        "checkpoint": str(checkpoint.resolve()),
+        "submission": str(submission.resolve()),
+        "submission_validation": validation_result,
+        "elapsed_seconds": elapsed,
+        "manual_interventions": 0,
+        "test_labels_read": False,
+    }
+    report = Path(args.report)
+    report.parent.mkdir(parents=True, exist_ok=True)
+    report.write_text(json.dumps(result, indent=2), encoding="utf-8")
+    submission.with_suffix(submission.suffix + ".meta.json").write_text(
+        json.dumps({**validation_result, "label_columns_read": [], "checkpoint": str(checkpoint.resolve())}, indent=2),
+        encoding="utf-8",
+    )
+    return result
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description="Official KuaiRand-Pure LambdaRank experiment")
+    parser.add_argument("--train-csv", default="data/official_pure/train.csv")
+    parser.add_argument("--validation-csv", default="data/official_pure/validation.csv")
+    parser.add_argument("--test-csv", default="data/official_pure/test.csv")
+    parser.add_argument(
+        "--video-features", default="data/raw/KuaiRand-Pure/data/video_features_basic_pure.csv"
+    )
+    parser.add_argument("--checkpoint", default="artifacts/official_checkpoints/official_pure_lambdarank/model.pkl")
+    parser.add_argument("--submission", default="artifacts/official_submissions/kuairand_pure.csv")
+    parser.add_argument("--report", default="artifacts/official_pure_lambdarank/summary.json")
+    parser.add_argument("--rounds", type=int, default=300)
+    parser.add_argument("--patience", type=int, default=30)
+    parser.add_argument("--learning-rate", type=float, default=0.05)
+    parser.add_argument("--num-leaves", type=int, default=63)
+    parser.add_argument("--num-threads", type=int, default=8)
+    parser.add_argument("--seed", type=int, default=42)
+    args = parser.parse_args()
+    print(json.dumps(run(args), indent=2))
+
+
+if __name__ == "__main__":
+    main()

diff --git a/src/research_rec/official_submit.py b/src/research_rec/official_submit.py
new file mode 100644
index 0000000..772a1c7
--- /dev/null
+++ b/src/research_rec/official_submit.py
@@ -0,0 +1,120 @@
+from __future__ import annotations
+
+import csv
+import hashlib
+import json
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+import pandas as pd
+import torch
+from torch.utils.data import DataLoader, TensorDataset
+
+from .config import config_from_dict
+from .data import load_scoring_interactions
+from .features import CategoricalFeatureEncoder
+from .models import build_model
+from .training import resolve_device
+
+
+OFFICIAL_HEADER = ["row_id", "user_id", "video_id", "score"]
+
+
+def _sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for block in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def _encoder_from_checkpoint(checkpoint: dict[str, Any]) -> CategoricalFeatureEncoder:
+    state = checkpoint["feature_encoder"]
+    encoder = CategoricalFeatureEncoder(list(state["columns"]))
+    encoder.vocabularies = state["vocabularies"]
+    return encoder
+
+
+@torch.inference_mode()
+def export_official_submission(
+    checkpoint_path: str | Path,
+    input_csv: str | Path,
+    output_csv: str | Path,
+    batch_size: int = 4096,
+    device_name: str = "auto",
+) -> dict[str, Any]:
+    """Write row-aligned Starter Kit output without reading any outcome label."""
+    checkpoint_file = Path(checkpoint_path)
+    device = resolve_device(device_name)
+    checkpoint = torch.load(checkpoint_file, map_location=device, weights_only=False)
+    config = config_from_dict(checkpoint["config"])
+    if config.data.evaluation_protocol != "techjam_official":
+        raise ValueError("Checkpoint was not trained with the TechJam official evaluation protocol")
+    frame = load_scoring_interactions(config.data, input_csv)
+    encoder = _encoder_from_checkpoint(checkpoint)
+    encoded = torch.as_tensor(encoder.transform(frame), dtype=torch.long)
+    model = build_model(
+        config.model,
+        checkpoint["field_dims"],
+        task_count=1 + len(config.data.auxiliary_label_columns),
+    ).to(device)
+    model.load_state_dict(checkpoint["model_state_dict"])
+    model.eval()
+    predictions: list[np.ndarray] = []
+    for (features,) in DataLoader(TensorDataset(encoded), batch_size=batch_size, shuffle=False):
+        logits = model(features.to(device))
+        primary = logits[:, 0] if logits.ndim == 2 else logits
+        predictions.append(primary.cpu().numpy())
+    scores = np.concatenate(predictions)
+    if not np.isfinite(scores).all():
+        raise ValueError("Model produced NaN or Inf scores")
+
+    destination = Path(output_csv)
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    temporary = destination.with_suffix(destination.suffix + ".tmp")
+    output = pd.DataFrame(
+        {
+            "row_id": np.arange(len(frame), dtype=np.int64),
+            "user_id": frame[config.data.user_column].to_numpy(),
+            "video_id": frame[config.data.item_column].to_numpy(),
+            "score": scores,
+        }
+    )
+    output.to_csv(temporary, index=False, columns=OFFICIAL_HEADER)
+    temporary.replace(destination)
+    summary = {
+        "schema": OFFICIAL_HEADER,
+        "rows": len(output),
+        "checkpoint": str(checkpoint_file.resolve()),
+        "input": str(Path(input_csv).resolve()),
+        "output": str(destination.resolve()),
+        "sha256": _sha256(destination),
+        "label_columns_read": [],
+        "row_order_preserved": True,
+    }
+    destination.with_suffix(destination.suffix + ".meta.json").write_text(
+        json.dumps(summary, indent=2), encoding="utf-8"
+    )
+    return summary
+
+
+def validate_official_submission(path: str | Path, input_csv: str | Path) -> dict[str, Any]:
+    """Validate schema and alignment while intentionally never loading labels."""
+    expected = pd.read_csv(input_csv, usecols=["user_id", "video_id"])
+    actual = pd.read_csv(path)
+    if list(actual.columns) != OFFICIAL_HEADER:
+        raise ValueError(f"Header must be {','.join(OFFICIAL_HEADER)}")
+    if len(actual) != len(expected):
+        raise ValueError(f"Submission has {len(actual)} rows; expected {len(expected)}")
+    row_ids = actual["row_id"].to_numpy()
+    if not np.array_equal(row_ids, np.arange(len(expected))):
+        raise ValueError("row_id must be strictly increasing from zero without gaps")
+    if not np.array_equal(actual["user_id"].to_numpy(), expected["user_id"].to_numpy()):
+        raise ValueError("user_id values are not aligned with the evaluation split")
+    if not np.array_equal(actual["video_id"].to_numpy(), expected["video_id"].to_numpy()):
+        raise ValueError("video_id values are not aligned with the evaluation split")
+    scores = pd.to_numeric(actual["score"], errors="coerce").to_numpy()
+    if not np.isfinite(scores).all():
+        raise ValueError("score contains a non-numeric, NaN, or infinite value")
+    return {"status": "valid", "rows": len(actual), "sha256": _sha256(Path(path)), "labels_read": []}

