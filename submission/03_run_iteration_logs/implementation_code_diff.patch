+++ b/src/research_rec/official_submit_cli.py
@@ -0,0 +1,32 @@
+from __future__ import annotations
+
+import argparse
+import json
+
+from .official_submit import export_official_submission, validate_official_submission
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description="Create or validate the official TechJam submission schema")
+    parser.add_argument("path")
+    parser.add_argument("--input-csv", required=True)
+    group = parser.add_mutually_exclusive_group(required=True)
+    group.add_argument("--make", action="store_true")
+    group.add_argument("--check", action="store_true")
+    parser.add_argument("--checkpoint")
+    parser.add_argument("--batch-size", type=int, default=4096)
+    parser.add_argument("--device", default="auto")
+    args = parser.parse_args()
+    if args.make:
+        if not args.checkpoint:
+            parser.error("--make requires --checkpoint")
+        result = export_official_submission(
+            args.checkpoint, args.input_csv, args.path, args.batch_size, args.device
+        )
+    else:
+        result = validate_official_submission(args.path, args.input_csv)
+    print(json.dumps(result, indent=2))
+
+
+if __name__ == "__main__":
+    main()

