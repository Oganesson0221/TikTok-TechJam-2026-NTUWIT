+import pandas as pd
+import pytest
+
+from research_rec.official_submit import validate_official_submission
+
+
+def test_official_submission_validator_checks_row_alignment_without_labels(tmp_path):
+    source = tmp_path / "test.csv"
+    output = tmp_path / "submission.csv"
+    pd.DataFrame({"user_id": [2, 2], "video_id": [9, 9], "long_view": [1, 0]}).to_csv(source, index=False)
+    pd.DataFrame(
+        {"row_id": [0, 1], "user_id": [2, 2], "video_id": [9, 9], "score": [0.2, 0.1]}
+    ).to_csv(output, index=False)
+    assert validate_official_submission(output, source)["labels_read"] == []
+    broken = pd.read_csv(output)
+    broken.loc[1, "row_id"] = 3
+    broken.to_csv(output, index=False)
+    with pytest.raises(ValueError, match="row_id"):
+        validate_official_submission(output, source)
