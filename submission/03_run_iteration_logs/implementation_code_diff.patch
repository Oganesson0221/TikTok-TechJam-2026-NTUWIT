-  --checkpoint artifacts/checkpoints/<winner>/best.pt \
-  --input-csv data/prepared/test.csv \
-  --output-csv artifacts/submissions/kuairand_pure_top50.csv \
-  --top-k 50 \
-  --columns user_id,video_id,score,rank \
