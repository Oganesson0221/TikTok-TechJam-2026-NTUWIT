--- a/src/research_rec/metrics.py
+++ b/src/research_rec/metrics.py
@@ -3,6 +3,143 @@ from __future__ import annotations
 import numpy as np
 
 
+def _auc_with_ties(labels: np.ndarray, scores: np.ndarray) -> float:
+    """Mann-Whitney AUC with average ranks for tied scores."""
+    order = np.argsort(scores, kind="stable")
+    sorted_scores = scores[order]
+    sorted_labels = labels[order]
+    ranks = np.empty(len(labels), dtype=np.float64)
+    start = 0
+    while start < len(labels):
+        end = start + 1
+        while end < len(labels) and sorted_scores[end] == sorted_scores[start]:
+            end += 1
+        ranks[start:end] = (start + 1 + end) / 2.0
+        start = end
+    positives = int(sorted_labels.sum())
+    negatives = len(labels) - positives
+    if positives == 0 or negatives == 0:
+        return 0.5
+    positive_rank_sum = float(ranks[sorted_labels == 1].sum())
+    return (positive_rank_sum - positives * (positives + 1) / 2.0) / (positives * negatives)
+
+
+def official_ranking_metrics(users: np.ndarray, labels: np.ndarray, scores: np.ndarray) -> dict[str, float]:
+    """Exact TechJam Starter Kit GAUC / nDCG@5 conventions."""
+    users = np.asarray(users)
+    labels = np.asarray(labels)
+    scores = np.asarray(scores)
+    if not (len(users) == len(labels) == len(scores)):
+        raise ValueError("users, labels, and scores must have equal lengths")
+    if len(users) == 0:
+        return {"GAUC": 0.5, "nDCG@5": 0.0, "primary": 0.25, "users": 0, "rows": 0}
+
+    order = np.lexsort((-scores, users))
+    sorted_users = users[order]
+    sorted_labels = labels[order]
+    sorted_scores = scores[order]
+    boundaries = np.flatnonzero(sorted_users[1:] != sorted_users[:-1]) + 1
+    label_groups = np.split(sorted_labels, boundaries)
+    score_groups = np.split(sorted_scores, boundaries)
+    gauc_numerator = 0.0
+    gauc_denominator = 0.0
+    ndcg_total = 0.0
+    discounts = 1.0 / np.log2(np.arange(5) + 2.0)
+    for user_labels, user_scores in zip(label_groups, score_groups, strict=True):
+        positive_count = int(user_labels.sum())
+        if 0 < positive_count < len(user_labels):
+            gauc_numerator += positive_count * _auc_with_ties(user_labels, user_scores)
+            gauc_denominator += positive_count
+        top_labels = user_labels[:5]
+        dcg = float(np.sum(top_labels * discounts[: len(top_labels)]))
+        ideal_count = min(positive_count, 5)
+        idcg = float(discounts[:ideal_count].sum())
+        ndcg_total += 0.0 if idcg == 0.0 else dcg / idcg
+    gauc = gauc_numerator / gauc_denominator if gauc_denominator else 0.5
+    ndcg = ndcg_total / len(label_groups)
+    return {
+        "GAUC": float(gauc),
+        "nDCG@5": float(ndcg),
+        "primary": float((gauc + ndcg) / 2.0),
+        "users": len(label_groups),
+        "rows": len(labels),
+    }
+
+
+def official_and_supplemental_ranking_metrics(
+    users: np.ndarray, labels: np.ndarray, scores: np.ndarray
+) -> dict[str, float]:
+    """Return Starter Kit and portal-requested metrics using one global sort."""
+    users = np.asarray(users)
+    labels = np.asarray(labels)
+    scores = np.asarray(scores)
+    if not (len(users) == len(labels) == len(scores)):
+        raise ValueError("users, labels, and scores must have equal lengths")
+    if len(users) == 0:
+        return {
+            "GAUC": 0.5,
+            "nDCG@5": 0.0,
+            "primary": 0.25,
+            "users": 0,
+            "rows": 0,
+            "ndcg@10": 0.0,
+            "recall@50": 0.0,
+            "evaluated_users": 0,
+        }
+
+    order = np.lexsort((-scores, users))
+    sorted_users = users[order]
+    sorted_labels = labels[order]
+    sorted_scores = scores[order]
+    boundaries = np.flatnonzero(sorted_users[1:] != sorted_users[:-1]) + 1
+    label_groups = np.split(sorted_labels, boundaries)
+    score_groups = np.split(sorted_scores, boundaries)
+    discounts5 = 1.0 / np.log2(np.arange(5) + 2.0)
+    discounts10 = 1.0 / np.log2(np.arange(10) + 2.0)
+    gauc_numerator = gauc_denominator = ndcg5_total = 0.0
+    ndcg10_total = recall50_total = 0.0
+    evaluated_users = 0
+    candidate_counts: list[int] = []
+    for user_labels, user_scores in zip(label_groups, score_groups, strict=True):
+        positive_count = int(user_labels.sum())
+        if 0 < positive_count < len(user_labels):
+            gauc_numerator += positive_count * _auc_with_ties(user_labels, user_scores)
+            gauc_denominator += positive_count
+        top5 = user_labels[:5]
+        idcg5 = float(discounts5[: min(positive_count, 5)].sum())
+        ndcg5_total += 0.0 if idcg5 == 0.0 else float(np.sum(top5 * discounts5[: len(top5)])) / idcg5
+        if positive_count:
+            top10 = user_labels[:10]
+            idcg10 = float(discounts10[: min(positive_count, 10)].sum())
+            ndcg10_total += float(np.sum(top10 * discounts10[: len(top10)])) / idcg10
+            recall50_total += float(user_labels[:50].sum()) / positive_count
+            evaluated_users += 1
+            candidate_counts.append(len(user_labels))
+    user_count = len(label_groups)
+    gauc = gauc_numerator / gauc_denominator if gauc_denominator else 0.5
+    ndcg5 = ndcg5_total / user_count
+    counts = np.asarray(candidate_counts)
+    result: dict[str, float] = {
+        "GAUC": float(gauc),
+        "nDCG@5": float(ndcg5),
+        "primary": float((gauc + ndcg5) / 2.0),
+        "users": user_count,
+        "rows": len(labels),
+        "ndcg@10": ndcg10_total / evaluated_users if evaluated_users else 0.0,
+        "recall@50": recall50_total / evaluated_users if evaluated_users else 0.0,
+        "evaluated_users": evaluated_users,
+    }
+    if evaluated_users:
+        result.update(
+            {
+                "median_candidates_per_user": float(np.median(counts)),
+                "p95_candidates_per_user": float(np.percentile(counts, 95)),
+                "users_at_or_below_recall_k_fraction": float(np.mean(counts <= 50)),
+            }
+        )
+    return result
+
+
 def ranking_metrics(
     users: np.ndarray,
     labels: np.ndarray,
