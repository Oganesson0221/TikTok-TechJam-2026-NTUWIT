+#!/usr/bin/env python3
+"""Build the validation-selected Pure ensemble without reading test outcomes."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import pandas as pd
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--fm", type=Path, required=True)
+    parser.add_argument("--deepfm", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--fm-weight", type=float, default=0.70)
+    parser.add_argument("--metadata", type=Path)
+    args = parser.parse_args()
+
+    fm = pd.read_csv(args.fm)
+    deepfm = pd.read_csv(args.deepfm)
+    expected = ["row_id", "user_id", "video_id", "score"]
+    if list(fm.columns) != expected or list(deepfm.columns) != expected:
+        raise ValueError(f"both inputs must have exact schema {expected}")
+    if not fm.iloc[:, :3].equals(deepfm.iloc[:, :3]):
+        raise ValueError("input row_id/user_id/video_id columns are not aligned")
+    if not 0.0 <= args.fm_weight <= 1.0:
+        raise ValueError("--fm-weight must be in [0, 1]")
+
+    output = fm.iloc[:, :3].copy()
+    output["score"] = args.fm_weight * fm["score"] + (1.0 - args.fm_weight) * deepfm["score"]
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    output.to_csv(args.output, index=False)
+
+    metadata = {
+        "method": "raw_score_weighted_ensemble",
+        "fm_weight": args.fm_weight,
+        "deepfm_weight": 1.0 - args.fm_weight,
+        "rows": len(output),
+        "schema": expected,
+        "test_outcome_columns_read": [],
+        "weight_selected_on": "validation only",
+    }
+    metadata_path = args.metadata or args.output.with_suffix(args.output.suffix + ".meta.json")
+    metadata_path.write_text(json.dumps(metadata, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps({"output": str(args.output), **metadata}, indent=2))
+
+
+if __name__ == "__main__":
+    main()

