+#!/bin/bash
+
+set -euo pipefail
+SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
+REPO_ROOT=$(cd "$SCRIPT_DIR/.." && pwd)
+cd "$REPO_ROOT"
+export PYTHONPATH="$REPO_ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
+
+test -f data/official_pure/train.csv
+test -f data/official_pure/validation.csv
+test -f data/official_pure/test.csv
+
+python3 scripts/run_official_fm_bpr.py \
+  --submission artifacts/official_submissions/kuairand_pure_fm.csv \
+  --validation-output artifacts/official_submissions/kuairand_pure_fm_valid.csv
+for seed in 1 2; do
+  python3 scripts/run_official_side_fm.py --mode base --seed "$seed"
+done
+for seed in 0 1 2; do
+  python3 scripts/run_official_side_fm.py --mode full_context --seed "$seed"
+done
+
+python3 -m research_rec.cli --config configs/official_pure_deepfm.json
+python3 -m research_rec.official_submit_cli \
+  artifacts/official_submissions/kuairand_pure_deepfm_valid.csv \
+  --input-csv data/official_pure/validation.csv --make \
+  --checkpoint artifacts/official_checkpoints/official_pure_deepfm/best.pt
+python3 -m research_rec.official_submit_cli \
+  artifacts/official_submissions/kuairand_pure_deepfm.csv \
+  --input-csv data/official_pure/test.csv --make \
+  --checkpoint artifacts/official_checkpoints/official_pure_deepfm/best.pt
+
+build_ensemble() {
+  local split_suffix="$1" output="$2" fm_source="$3" deep_source="$4"
+  python3 scripts/build_official_multi_ensemble.py \
+    --component "fm_seed0=0.18333333333333335=$fm_source" \
+    --component "fm_seed1=0.18333333333333335=artifacts/official_side_fm/base_seed1/$split_suffix.csv" \
+    --component "fm_seed2=0.18333333333333335=artifacts/official_side_fm/base_seed2/$split_suffix.csv" \
+    --component "deepfm=0.125=$deep_source" \
+    --component "context_seed0=0.10833333333333334=artifacts/official_side_fm/full_context_seed0/$split_suffix.csv" \
+    --component "context_seed1=0.10833333333333334=artifacts/official_side_fm/full_context_seed1/$split_suffix.csv" \
+    --component "context_seed2=0.10833333333333334=artifacts/official_side_fm/full_context_seed2/$split_suffix.csv" \
+    --output "$output"
+}
+
+build_ensemble valid artifacts/official_submissions/kuairand_pure_winner_valid.csv \
+  artifacts/official_submissions/kuairand_pure_fm_valid.csv \
+  artifacts/official_submissions/kuairand_pure_deepfm_valid.csv
+build_ensemble test artifacts/official_submissions/kuairand_pure_winner.csv \
+  artifacts/official_submissions/kuairand_pure_fm.csv \
+  artifacts/official_submissions/kuairand_pure_deepfm.csv
+
+python3 scripts/build_official_submission_package.py
+(
+  cd kuairand-starter-kit
+  python3 submit.py --data_dir ../data/raw/KuaiRand-Pure/data --check --split test \
+    ../submission/04_final_submission_results/files/kuairand_pure.csv
+)
+echo "Rebuilt and verified the official Pure submission package."

diff --git a/scripts/run_official_fm_bpr.py b/scripts/run_official_fm_bpr.py
