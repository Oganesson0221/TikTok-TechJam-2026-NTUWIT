+    sessions = sorted((Path.home() / ".codex/sessions").glob("**/*.jsonl"), key=lambda p: p.stat().st_mtime)
+    latest: dict | None = None
+    source: Path | None = None
+    for path in reversed(sessions):
+        try:
+            for line in path.read_text(encoding="utf-8").splitlines():
+                event = json.loads(line)
+                payload = event.get("payload", {})
+                if event.get("type") == "event_msg" and payload.get("type") == "token_count":
+                    latest = payload.get("info", {}).get("total_token_usage")
+                    source = path
+        except (OSError, json.JSONDecodeError):
+            continue
+        if latest:
+            break
+    if not latest:
+        return {"status": "unavailable", "input_tokens": None, "output_tokens": None, "total_tokens": None}
+    return {
+        "status": "measured_from_codex_session_counter",
+        "input_tokens": int(latest["input_tokens"]),
