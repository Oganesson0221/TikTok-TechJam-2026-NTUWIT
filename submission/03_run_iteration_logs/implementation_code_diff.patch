index 0000000..b762890
--- /dev/null
+++ b/scripts/run_official_fm_bpr.py
@@ -0,0 +1,241 @@
+#!/usr/bin/env python3
+"""Reproduce the official FM, then fine-tune it with within-user BPR.
+
+The test CSV is loaded with user/item/context columns only. Test long_view is
+never requested, evaluated, or used for model selection.
+"""
+
+from __future__ import annotations
+
+import argparse
+import csv
+import json
+import os
+import pickle
+import sys
+import time
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+
+
+ROOT = Path(__file__).resolve().parents[1]
+KIT = ROOT / "kuairand-starter-kit"
+sys.path.insert(0, str(KIT))
+import baseline as starter_baseline  # noqa: E402
+import data as starter_data  # noqa: E402
+
+sys.path.insert(0, str(ROOT / "src"))
+from research_rec.metrics import official_ranking_metrics  # noqa: E402
+
+
+def load_rows(path: str | Path, authors: dict[str, str], include_label: bool) -> list[tuple]:
+    columns = ["date", "user_id", "video_id", "tab", "duration_ms"]
+    if include_label:
+        columns.append("long_view")
+    frame = pd.read_csv(path, usecols=columns)
+    rows = []
+    labels = frame["long_view"].to_numpy() if include_label else np.zeros(len(frame), dtype=np.int8)
+    for date, user, video, tab, duration, label in zip(
+        frame["date"].to_numpy(),
+        frame["user_id"].astype(str).to_numpy(),
+        frame["video_id"].astype(str).to_numpy(),
+        frame["tab"].astype(str).to_numpy(),
+        frame["duration_ms"].to_numpy(),
+        labels,
+        strict=True,
+    ):
+        rows.append((int(date), user, video, authors.get(video, "UNK"), tab, float(duration), int(label != 0)))
+    return rows
+
+
+def bpr_step(model: starter_baseline.FM, positive: np.ndarray, negative: np.ndarray) -> float:
+    zp, ep, sp = model.logits(positive)
+    zn, en, sn = model.logits(negative)
+    difference = zp - zn
+    loss = np.logaddexp(0.0, -difference)
+    gradient = (-starter_baseline.sigmoid(-difference) / len(difference)).astype(np.float32)
+    grad_v = np.zeros_like(model.V)
+    grad_w = np.zeros_like(model.W)
+    np.add.at(grad_w, positive, gradient[:, None])
+    np.add.at(grad_w, negative, -gradient[:, None])
+    np.add.at(grad_v, positive, gradient[:, None, None] * (sp[:, None, :] - ep))
+    np.add.at(grad_v, negative, -gradient[:, None, None] * (sn[:, None, :] - en))
+    grad_v += model.l2 * model.V
+    grad_w += model.l2 * model.W
+    model.t += 1
+    beta1, beta2, epsilon = 0.9, 0.999, 1e-8
+    for parameter, grad, first, second in (
+        (model.V, grad_v, model.mV, model.vV),
+        (model.W, grad_w, model.mW, model.vW),
+    ):
+        first *= beta1
+        first += (1 - beta1) * grad
+        second *= beta2
+        second += (1 - beta2) * (grad * grad)
+        parameter -= model.lr * (first / (1 - beta1**model.t)) / (
+            np.sqrt(second / (1 - beta2**model.t)) + epsilon
+        )
+    return float(loss.mean())
+
+
+def make_pairs(users: np.ndarray, labels: np.ndarray, negatives_per_positive: int, seed: int) -> tuple[np.ndarray, np.ndarray]:
+    rng = np.random.default_rng(seed)
+    order = np.argsort(users, kind="stable")
+    sorted_users = users[order]
+    boundaries = np.flatnonzero(sorted_users[1:] != sorted_users[:-1]) + 1
+    positives: list[np.ndarray] = []
+    negatives: list[np.ndarray] = []
+    for indices in np.split(order, boundaries):
+        pos = indices[labels[indices] == 1]
+        neg = indices[labels[indices] == 0]
+        if len(pos) == 0 or len(neg) == 0:
+            continue
+        positives.append(np.repeat(pos, negatives_per_positive))
+        negatives.append(rng.choice(neg, size=len(pos) * negatives_per_positive, replace=True))
+    return np.concatenate(positives), np.concatenate(negatives)
+
+
+def write_submission(path: Path, rows: list[tuple], scores: np.ndarray) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    temporary = path.with_suffix(path.suffix + ".tmp")
+    with temporary.open("w", newline="", encoding="utf-8") as handle:
+        writer = csv.writer(handle)
+        writer.writerow(["row_id", "user_id", "video_id", "score"])
+        for row_id, (row, score) in enumerate(zip(rows, scores, strict=True)):
+            writer.writerow((row_id, row[1], row[2], f"{float(score):.8g}"))
+    os.replace(temporary, path)
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--train-csv", default="data/official_pure/train.csv")
+    parser.add_argument("--validation-csv", default="data/official_pure/validation.csv")
+    parser.add_argument("--test-csv", default="data/official_pure/test.csv")
+    parser.add_argument("--video-features", default="data/raw/KuaiRand-Pure/data/video_features_basic_pure.csv")
+    parser.add_argument("--bpr-epochs", type=int, default=6)
+    parser.add_argument("--bpr-lr", type=float, default=0.0002)
+    parser.add_argument("--pairs", type=int, default=2)
+    parser.add_argument("--batch-size", type=int, default=8192)
+    parser.add_argument("--seed", type=int, default=0)
+    parser.add_argument("--checkpoint", default="artifacts/official_checkpoints/official_pure_fm_bpr/model.pkl")
+    parser.add_argument("--submission", default="artifacts/official_submissions/kuairand_pure_fm_bpr.csv")
+    parser.add_argument("--validation-output", default="artifacts/official_submissions/kuairand_pure_fm_valid.csv")
+    parser.add_argument("--log", default="artifacts/official_pure_fm_bpr/iterations.jsonl")
+    args = parser.parse_args()
+    started = time.perf_counter()
+    authors: dict[str, str] = {}
+    with Path(args.video_features).open() as handle:
+        for row in csv.DictReader(handle):
+            authors[row["video_id"]] = row["author_id"]
+    splits = {
+        "train": load_rows(args.train_csv, authors, True),
+        "valid": load_rows(args.validation_csv, authors, True),
+        "test": load_rows(args.test_csv, authors, False),
+    }
+    encoded, dimension = starter_data.encode(splits)
+    x_train, y_train, train_users = encoded["train"]
+    x_valid, y_valid, valid_users = encoded["valid"]
+    x_test, _, _ = encoded["test"]
+    model = starter_baseline.FM(dimension, k=16, lr=0.001, seed=args.seed)
+    rng = np.random.default_rng(args.seed)
+    best_primary = float("-inf")
+    best_state = None
+    bad = 0
+    records: list[dict] = []
+    for epoch in range(1, 41):
+        indices = rng.permutation(len(y_train))
+        losses = [
+            model.step(x_train[indices[start : start + args.batch_size]], y_train[indices[start : start + args.batch_size]])
+            for start in range(0, len(indices), args.batch_size)
+        ]
+        metrics = official_ranking_metrics(np.asarray(valid_users), y_valid, model.predict(x_valid))
+        if metrics["primary"] > best_primary + 1e-5:
+            best_primary = metrics["primary"]
+            best_state = (model.V.copy(), model.W.copy(), np.float32(model.b))
+            bad = 0
+        else:
+            bad += 1
+        if bad >= 4:
+            break
+    model.V, model.W, model.b = best_state
+    baseline_metrics = official_ranking_metrics(np.asarray(valid_users), y_valid, model.predict(x_valid))
+    records.append(
+        {
+            "iteration": 1,
+            "hypothesis": "Reproduce the organizer five-field FM baseline before changing the loss.",
+            "code_diff": "No algorithmic diff; exact Starter Kit FM configuration.",
+            "metrics": baseline_metrics,
+            "errors": [],
+            "recoveries": [],
+            "manual_interventions": 0,
+        }
+    )
+    positive_indices, negative_indices = make_pairs(
+        np.asarray(train_users), y_train, args.pairs, args.seed
+    )
+    model.lr = args.bpr_lr
+    best_state = (model.V.copy(), model.W.copy(), np.float32(model.b))
+    best_metrics = baseline_metrics
+    for bpr_epoch in range(1, args.bpr_epochs + 1):
+        permutation = rng.permutation(len(positive_indices))
+        losses = []
+        for start in range(0, len(permutation), args.batch_size):
+            batch = permutation[start : start + args.batch_size]
+            losses.append(bpr_step(model, x_train[positive_indices[batch]], x_train[negative_indices[batch]]))
+        metrics = official_ranking_metrics(np.asarray(valid_users), y_valid, model.predict(x_valid))
+        records.append(
+            {
+                "iteration": bpr_epoch + 1,
+                "hypothesis": "Within-user BPR should align the official FM with GAUC and nDCG@5.",
+                "code_diff": {"loss": "pointwise_logloss -> BPR", "learning_rate": args.bpr_lr, "pairs": args.pairs},
+                "metrics": metrics,
+                "train_loss": float(np.mean(losses)),
+                "errors": [],
+                "recoveries": [],
+                "manual_interventions": 0,
+            }
+        )
+        if metrics["primary"] > best_metrics["primary"]:
+            best_metrics = metrics
+            best_state = (model.V.copy(), model.W.copy(), np.float32(model.b))
+    model.V, model.W, model.b = best_state
+    checkpoint = Path(args.checkpoint)
+    checkpoint.parent.mkdir(parents=True, exist_ok=True)
+    with checkpoint.open("wb") as handle:
+        pickle.dump(
+            {
+                "V": model.V,
+                "W": model.W,
+                "b": model.b,
+                "feature_contract": starter_data.FIELDS,
+                "encoder_rebuild": "Deterministic from official train split via kuairand-starter-kit/data.py::encode",
+                "validation_metrics": best_metrics,
+                "test_labels_read": False,
+            },
+            handle,
+        )
+    submission = Path(args.submission)
+    write_submission(Path(args.validation_output), splits["valid"], model.predict(x_valid))
+    write_submission(submission, splits["test"], model.predict(x_test))
+    log_path = Path(args.log)
+    log_path.parent.mkdir(parents=True, exist_ok=True)
+    log_path.write_text("".join(json.dumps(record) + "\n" for record in records), encoding="utf-8")
+    summary = {
+        "status": "completed",
+        "best_validation_metrics": best_metrics,
+        "official_validation_baseline": {"GAUC": 0.6674, "nDCG@5": 0.5357, "primary": 0.6016},
+        "iterations": len(records),
+        "elapsed_seconds": time.perf_counter() - started,
+        "checkpoint": str(checkpoint.resolve()),
+        "submission": str(submission.resolve()),
+        "test_labels_read": False,
+        "manual_interventions": 0,
+    }
+    (log_path.parent / "summary.json").write_text(json.dumps(summary, indent=2), encoding="utf-8")
+    print(json.dumps(summary, indent=2))
+
+
+if __name__ == "__main__":
+    main()

diff --git a/scripts/run_official_side_fm.py b/scripts/run_official_side_fm.py
new file mode 100644
index 0000000..73b69a9
--- /dev/null
+++ b/scripts/run_official_side_fm.py
@@ -0,0 +1,166 @@
+#!/usr/bin/env python3
+"""Train validation-selected FM feature ablations without reading test labels."""
+
+from __future__ import annotations
+
+import argparse
+import csv
+import json
+import pickle
+import sys
+import time
+from pathlib import Path
+
+import numpy as np
+
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "kuairand-starter-kit"))
+from baseline import FM  # noqa: E402
+from evaluate import evaluate  # noqa: E402
+
+
+USER_FIELDS = [
+    "follow_user_num_range", "register_days_range", "fans_user_num_range",
+    "friend_user_num_range", "user_active_degree",
+]
+VIDEO_FIELDS = ["author_id", "music_id", "video_type", "upload_type"]
+
+
+def read_map(path: Path, key: str, fields: list[str]) -> dict[str, list[str]]:
+    with path.open(newline="", encoding="utf-8") as handle:
+        return {row[key]: [row.get(field, "UNK") or "UNK" for field in fields] for row in csv.DictReader(handle)}
+
+
+def read_rows(data_dir: Path) -> dict[str, list[dict[str, str]]]:
+    output: dict[str, list[dict[str, str]]] = {"train": [], "valid": [], "test": []}
+    paths = [
+        data_dir / "log_standard_4_08_to_4_21_pure.csv",
+        data_dir / "log_standard_4_22_to_5_08_pure.csv",
+    ]
+    fields = ["user_id", "video_id", "tab", "duration_ms", "hourmin", "date", "long_view"]
+    for path in paths:
+        with path.open(newline="", encoding="utf-8") as handle:
+            for row in csv.DictReader(handle):
+                date = int(row["date"])
+                split = "train" if date <= 20220421 else "valid" if date <= 20220428 else "test"
+                # Test outcomes are deliberately dropped at ingestion.
+                record = {field: row[field] for field in fields if field != "long_view" or split != "test"}
+                output[split].append(record)
+    return output
+
+
+def encode(
+    rows: dict[str, list[dict[str, str]]],
+    user_features: dict[str, list[str]],
+    video_features: dict[str, list[str]],
+    mode: str,
+) -> tuple[dict[str, tuple[np.ndarray, np.ndarray | None, np.ndarray]], int, list[dict[str, int]], np.ndarray]:
+    durations = np.array([float(row["duration_ms"]) for row in rows["train"]])
+    edges = np.quantile(durations, np.linspace(0, 1, 11)[1:-1])
+
+    def raw(row: dict[str, str]) -> list[str]:
+        video = video_features.get(row["video_id"], ["UNK"] * len(VIDEO_FIELDS))
+        user = user_features.get(row["user_id"], ["UNK"] * len(USER_FIELDS))
+        values = [
+            row["user_id"], row["video_id"], video[0], row["tab"],
+            str(int(np.searchsorted(edges, float(row["duration_ms"])))),
+        ]
+        if mode in {"item", "full", "full_context"}:
+            values += video[1:]
+        if mode in {"full", "full_context"}:
+            values += user
+        if mode == "full_context":
+            values += [str(min(23, max(0, int(row["hourmin"]) // 100))), str(int(row["date"]) % 7)]
+        return values
+
+    field_count = len(raw(rows["train"][0]))
+    vocabs: list[dict[str, int]] = [dict() for _ in range(field_count)]
+    for row in rows["train"]:
+        for index, value in enumerate(raw(row)):
+            if value not in vocabs[index]:
+                vocabs[index][value] = len(vocabs[index])
+    unknown = [len(vocab) for vocab in vocabs]
+    dimensions = [len(vocab) + 1 for vocab in vocabs]
+    offsets = np.cumsum([0, *dimensions[:-1]]).astype(np.int32)
+    encoded = {}
+    for split, split_rows in rows.items():
+        features = np.empty((len(split_rows), field_count), dtype=np.int32)
+        users = np.empty(len(split_rows), dtype=np.int32)
+        labels = None if split == "test" else np.empty(len(split_rows), dtype=np.float32)
+        for row_index, row in enumerate(split_rows):
+            users[row_index] = int(row["user_id"])
+            for field_index, value in enumerate(raw(row)):
+                features[row_index, field_index] = vocabs[field_index].get(value, unknown[field_index]) + offsets[field_index]
+            if labels is not None:
+                labels[row_index] = 1.0 if row["long_view"] != "0" else 0.0
+        encoded[split] = (features, labels, users)
+    return encoded, int(sum(dimensions)), vocabs, edges
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--data-dir", type=Path, default=ROOT / "data/raw/KuaiRand-Pure/data")
+    parser.add_argument("--mode", choices=["base", "item", "full", "full_context"], required=True)
+    parser.add_argument("--seed", type=int, default=0)
+    parser.add_argument("--epochs", type=int, default=40)
+    args = parser.parse_args()
+    started = time.perf_counter()
+    rows = read_rows(args.data_dir)
+    users = read_map(args.data_dir / "user_features_pure.csv", "user_id", USER_FIELDS)
+    videos = read_map(args.data_dir / "video_features_basic_pure.csv", "video_id", VIDEO_FIELDS)
+    encoded, dimension, vocabs, edges = encode(rows, users, videos, args.mode)
+    x_train, y_train, _ = encoded["train"]
+    x_valid, y_valid, u_valid = encoded["valid"]
+    x_test, _, _ = encoded["test"]
+    assert y_train is not None and y_valid is not None
+    model = FM(dimension, k=16, lr=0.001, seed=args.seed)
+    rng = np.random.default_rng(args.seed)
+    best_primary = -1.0
+    best_state = None
+    history = []
+    bad = 0
+    batch_size = 8192
+    for epoch in range(1, args.epochs + 1):
+        order = rng.permutation(len(y_train))
+        losses = [model.step(x_train[order[i:i + batch_size]], y_train[order[i:i + batch_size]]) for i in range(0, len(order), batch_size)]
+        metrics = {key: float(value) for key, value in evaluate(u_valid, y_valid, model.predict(x_valid)).items()}
+        history.append({"epoch": epoch, "loss": float(np.mean(losses)), **metrics})
+        print(json.dumps(history[-1]), flush=True)
+        if metrics["primary"] > best_primary + 1e-5:
+            best_primary = metrics["primary"]
+            best_state = (model.V.copy(), model.W.copy(), np.float32(model.b))
+            bad = 0
+        else:
+            bad += 1
+            if bad >= 4:
+                break
+    assert best_state is not None
+    model.V, model.W, model.b = best_state
+    valid_scores = model.predict(x_valid)
+    test_scores = model.predict(x_test)
+    metrics = {key: float(value) for key, value in evaluate(u_valid, y_valid, valid_scores).items()}
+    out_dir = ROOT / f"artifacts/official_side_fm/{args.mode}_seed{args.seed}"
+    out_dir.mkdir(parents=True, exist_ok=True)
+    with (out_dir / "model.pkl").open("wb") as handle:
+        pickle.dump({"V": model.V, "W": model.W, "b": model.b, "mode": args.mode, "vocabs": vocabs, "edges": edges}, handle)
+    for split, scores in (("valid", valid_scores), ("test", test_scores)):
+        output = out_dir / f"{split}.csv"
+        with output.open("w", newline="", encoding="utf-8") as handle:
+            writer = csv.writer(handle)
+            writer.writerow(["row_id", "user_id", "video_id", "score"])
+            for row_id, (row, score) in enumerate(zip(rows[split], scores, strict=True)):
+                writer.writerow([row_id, row["user_id"], row["video_id"], f"{float(score):.8g}"])
+    summary = {
+        "status": "completed", "mode": args.mode, "seed": args.seed,
+        "hypothesis": "Additional train-known side/context fields improve long-view ordering beyond the five-field FM.",
+        "validation_metrics": metrics, "history": history,
+        "elapsed_seconds": time.perf_counter() - started,
+        "test_labels_read": False, "manual_interventions": 0,
+    }
+    (out_dir / "summary.json").write_text(json.dumps(summary, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps(summary, indent=2), flush=True)
+
+
+if __name__ == "__main__":
+    main()

diff --git a/src/research_rec/official_lambdarank.py b/src/research_rec/official_lambdarank.py
new file mode 100644
index 0000000..72d5396
--- /dev/null
+++ b/src/research_rec/official_lambdarank.py
@@ -0,0 +1,260 @@
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+import pickle
+import time
+from pathlib import Path
+from typing import Any
+
+import lightgbm as lgb
+import numpy as np
+import pandas as pd
+
+from .metrics import official_ranking_metrics
+from .official_submit import OFFICIAL_HEADER, validate_official_submission
+
+
+RAW_COLUMNS = ["user_id", "video_id", "date", "hourmin", "duration_ms", "tab", "long_view"]
+MODEL_COLUMNS = [
+    "user_id",
+    "video_id",
+    "author_id",
+    "tab",
+    "duration_bucket",
+    "hour",
+    "weekday",
+    "item_long_view_rate",
+    "author_long_view_rate",
+    "user_author_long_view_rate",
+    "user_duration_long_view_rate",
+]
+CATEGORICAL_COLUMNS = ["user_id", "video_id", "author_id", "tab", "duration_bucket", "hour", "weekday"]
+
+
+def _read_interactions(path: str | Path, include_label: bool) -> pd.DataFrame:
+    columns = RAW_COLUMNS if include_label else [column for column in RAW_COLUMNS if column != "long_view"]
+    frame = pd.read_csv(path, usecols=columns)
+    frame["_row_order"] = np.arange(len(frame), dtype=np.int64)
+    return frame
+
+
+def _prepare_context(frame: pd.DataFrame, video_features: pd.DataFrame) -> pd.DataFrame:
+    result = frame.merge(video_features, on="video_id", how="left", validate="many_to_one", sort=False)
+    result = result.sort_values("_row_order", kind="stable")
+    result["author_id"] = result["author_id"].fillna(-1).astype(np.int64)
+    duration = pd.to_numeric(result["duration_ms"], errors="coerce").fillna(0).to_numpy()
+    result["duration_bucket"] = np.minimum(np.log2(np.maximum(duration, 0) / 1000.0 + 1).astype(int), 31)
+    hourmin = pd.to_numeric(result["hourmin"], errors="coerce").fillna(0).astype(np.int64)
+    result["hour"] = (hourmin // 100).clip(0, 23)
+    dates = pd.to_datetime(result["date"].astype(str), format="%Y%m%d")
+    result["weekday"] = dates.dt.dayofweek.astype(np.int64)
+    result["tab"] = pd.to_numeric(result["tab"], errors="coerce").fillna(0).astype(np.int64)
+    return result
+
+
+def _rate_table(train: pd.DataFrame, keys: list[str], prefix: str) -> pd.DataFrame:
+    table = train.groupby(keys, sort=False)["long_view"].agg(["sum", "count"]).reset_index()
+    return table.rename(columns={"sum": f"{prefix}_sum", "count": f"{prefix}_count"})
+
+
+def _fit_statistics(train: pd.DataFrame) -> dict[str, Any]:
+    return {
+        "global_rate": float(train["long_view"].mean()),
+        "item": _rate_table(train, ["video_id"], "item"),
+        "author": _rate_table(train, ["author_id"], "author"),
+        "user_author": _rate_table(train, ["user_id", "author_id"], "user_author"),
+        "user_duration": _rate_table(train, ["user_id", "duration_bucket"], "user_duration"),
+    }
+
+
+def _attach_rate(
+    frame: pd.DataFrame,
+    table: pd.DataFrame,
+    keys: list[str],
+    prefix: str,
+    prior: float,
+    global_rate: float,
+    leave_one_out: bool,
+) -> pd.DataFrame:
+    result = frame.merge(table, on=keys, how="left", validate="many_to_one", sort=False)
+    sums = result[f"{prefix}_sum"].fillna(0).to_numpy(dtype=np.float64)
+    counts = result[f"{prefix}_count"].fillna(0).to_numpy(dtype=np.float64)
+    if leave_one_out:
+        labels = result["long_view"].to_numpy(dtype=np.float64)
+        sums -= labels
+        counts -= 1.0
+    result[f"{prefix}_long_view_rate"] = (sums + prior * global_rate) / (counts + prior)
+    return result.drop(columns=[f"{prefix}_sum", f"{prefix}_count"])
+
+
+def _build_features(frame: pd.DataFrame, stats: dict[str, Any], leave_one_out: bool) -> pd.DataFrame:
+    global_rate = stats["global_rate"]
+    result = _attach_rate(frame, stats["item"], ["video_id"], "item", 20.0, global_rate, leave_one_out)
+    result = _attach_rate(result, stats["author"], ["author_id"], "author", 50.0, global_rate, leave_one_out)
+    result = _attach_rate(
+        result, stats["user_author"], ["user_id", "author_id"], "user_author", 10.0, global_rate, leave_one_out
+    )
+    result = _attach_rate(
+        result,
+        stats["user_duration"],
+        ["user_id", "duration_bucket"],
+        "user_duration",
+        10.0,
+        global_rate,
+        leave_one_out,
+    )
+    return result[MODEL_COLUMNS]
+
+
+def _groups(users: pd.Series) -> np.ndarray:
+    values = users.to_numpy()
+    if np.any(values[1:] < values[:-1]):
+        raise ValueError("Official LambdaRank input must remain sorted by user_id")
+    return users.groupby(users, sort=False).size().to_numpy(dtype=np.int32)
+
+
+def _sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for block in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def run(args: argparse.Namespace) -> dict[str, Any]:
+    started = time.perf_counter()
+    video_features = pd.read_csv(args.video_features, usecols=["video_id", "author_id"])
+    train = _prepare_context(_read_interactions(args.train_csv, True), video_features)
+    validation = _prepare_context(_read_interactions(args.validation_csv, True), video_features)
+    stats = _fit_statistics(train)
+    train_ranked = train.sort_values(["user_id", "_row_order"], kind="stable").reset_index(drop=True)
+    validation_ranked = validation.sort_values(["user_id", "_row_order"], kind="stable").reset_index(drop=True)
+    train_features = _build_features(train_ranked, stats, leave_one_out=True)
+    validation_features = _build_features(validation_ranked, stats, leave_one_out=False)
+    train_set = lgb.Dataset(
+        train_features,
+        label=train_ranked["long_view"].to_numpy(dtype=np.int8),
+        group=_groups(train_ranked["user_id"]),
+        categorical_feature=CATEGORICAL_COLUMNS,
+        free_raw_data=False,
+    )
+    validation_set = lgb.Dataset(
+        validation_features,
+        label=validation_ranked["long_view"].to_numpy(dtype=np.int8),
+        group=_groups(validation_ranked["user_id"]),
+        categorical_feature=CATEGORICAL_COLUMNS,
+        reference=train_set,
+        free_raw_data=False,
+    )
+    params = {
+        "objective": "lambdarank",
+        "metric": "ndcg",
+        "ndcg_eval_at": [5],
+        "label_gain": [0, 1],
+        "learning_rate": args.learning_rate,
+        "num_leaves": args.num_leaves,
+        "min_data_in_leaf": 100,
+        "feature_fraction": 0.9,
+        "bagging_fraction": 0.9,
+        "bagging_freq": 1,
+        "lambda_l2": 1e-4,
+        "seed": args.seed,
+        "num_threads": args.num_threads,
+        "verbosity": -1,
+    }
+    booster = lgb.train(
+        params,
+        train_set,
+        num_boost_round=args.rounds,
+        valid_sets=[validation_set],
+        valid_names=["validation"],
+        callbacks=[lgb.early_stopping(args.patience), lgb.log_evaluation(10)],
+    )
+    validation_scores = booster.predict(validation_features, num_iteration=booster.best_iteration)
+    metrics = official_ranking_metrics(
+        validation_ranked["user_id"].to_numpy(),
+        validation_ranked["long_view"].to_numpy(),
+        validation_scores,
+    )
+
+    checkpoint = Path(args.checkpoint)
+    checkpoint.parent.mkdir(parents=True, exist_ok=True)
+    temporary_checkpoint = checkpoint.with_suffix(checkpoint.suffix + ".tmp")
+    with temporary_checkpoint.open("wb") as handle:
+        pickle.dump({"booster": booster, "statistics": stats, "model_columns": MODEL_COLUMNS}, handle)
+    os.replace(temporary_checkpoint, checkpoint)
+
+    test = _prepare_context(_read_interactions(args.test_csv, False), video_features)
+    test_features = _build_features(test, stats, leave_one_out=False)
+    test_scores = booster.predict(test_features, num_iteration=booster.best_iteration)
+    if not np.isfinite(test_scores).all():
+        raise ValueError("LambdaRank produced NaN or Inf test scores")
+    submission = Path(args.submission)
+    submission.parent.mkdir(parents=True, exist_ok=True)
+    temporary_submission = submission.with_suffix(submission.suffix + ".tmp")
+    pd.DataFrame(
+        {
+            "row_id": np.arange(len(test), dtype=np.int64),
+            "user_id": test["user_id"].to_numpy(),
+            "video_id": test["video_id"].to_numpy(),
+            "score": test_scores,
+        }
+    ).to_csv(temporary_submission, index=False, columns=OFFICIAL_HEADER)
+    os.replace(temporary_submission, submission)
+    validation_result = validate_official_submission(submission, args.test_csv)
+    elapsed = time.perf_counter() - started
+    result = {
+        "status": "completed",
+        "benchmark": "KuaiRand-Pure",
+        "hypothesis": "LambdaRank plus train-only user-history aggregates aligns optimization with GAUC/nDCG@5 and adds missing sequential preference signal.",
+        "validation_metrics": metrics,
+        "official_fm_validation": {"GAUC": 0.6674, "nDCG@5": 0.5357, "primary": 0.6016},
+        "validation_delta_over_official_fm": {
+            "GAUC": metrics["GAUC"] - 0.6674,
+            "nDCG@5": metrics["nDCG@5"] - 0.5357,
+            "primary": metrics["primary"] - 0.6016,
+        },
+        "best_iteration": booster.best_iteration,
+        "checkpoint": str(checkpoint.resolve()),
+        "submission": str(submission.resolve()),
+        "submission_validation": validation_result,
+        "elapsed_seconds": elapsed,
+        "manual_interventions": 0,
+        "test_labels_read": False,
+    }
+    report = Path(args.report)
+    report.parent.mkdir(parents=True, exist_ok=True)
+    report.write_text(json.dumps(result, indent=2), encoding="utf-8")
+    submission.with_suffix(submission.suffix + ".meta.json").write_text(
+        json.dumps({**validation_result, "label_columns_read": [], "checkpoint": str(checkpoint.resolve())}, indent=2),
+        encoding="utf-8",
+    )
+    return result
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description="Official KuaiRand-Pure LambdaRank experiment")
+    parser.add_argument("--train-csv", default="data/official_pure/train.csv")
+    parser.add_argument("--validation-csv", default="data/official_pure/validation.csv")
+    parser.add_argument("--test-csv", default="data/official_pure/test.csv")
+    parser.add_argument(
+        "--video-features", default="data/raw/KuaiRand-Pure/data/video_features_basic_pure.csv"
+    )
+    parser.add_argument("--checkpoint", default="artifacts/official_checkpoints/official_pure_lambdarank/model.pkl")
+    parser.add_argument("--submission", default="artifacts/official_submissions/kuairand_pure.csv")
+    parser.add_argument("--report", default="artifacts/official_pure_lambdarank/summary.json")
+    parser.add_argument("--rounds", type=int, default=300)
+    parser.add_argument("--patience", type=int, default=30)
+    parser.add_argument("--learning-rate", type=float, default=0.05)
+    parser.add_argument("--num-leaves", type=int, default=63)
+    parser.add_argument("--num-threads", type=int, default=8)
+    parser.add_argument("--seed", type=int, default=42)
+    args = parser.parse_args()
+    print(json.dumps(run(args), indent=2))
+
+
+if __name__ == "__main__":
+    main()

diff --git a/src/research_rec/official_submit.py b/src/research_rec/official_submit.py
new file mode 100644
index 0000000..772a1c7
--- /dev/null
+++ b/src/research_rec/official_submit.py
@@ -0,0 +1,120 @@
+from __future__ import annotations
+
+import csv
+import hashlib
+import json
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+import pandas as pd
+import torch
+from torch.utils.data import DataLoader, TensorDataset
+
+from .config import config_from_dict
+from .data import load_scoring_interactions
+from .features import CategoricalFeatureEncoder
+from .models import build_model
+from .training import resolve_device
+
+
+OFFICIAL_HEADER = ["row_id", "user_id", "video_id", "score"]
+
+
+def _sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for block in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def _encoder_from_checkpoint(checkpoint: dict[str, Any]) -> CategoricalFeatureEncoder:
+    state = checkpoint["feature_encoder"]
+    encoder = CategoricalFeatureEncoder(list(state["columns"]))
+    encoder.vocabularies = state["vocabularies"]
+    return encoder
+
+
+@torch.inference_mode()
+def export_official_submission(
+    checkpoint_path: str | Path,
+    input_csv: str | Path,
+    output_csv: str | Path,
+    batch_size: int = 4096,
+    device_name: str = "auto",
+) -> dict[str, Any]:
+    """Write row-aligned Starter Kit output without reading any outcome label."""
+    checkpoint_file = Path(checkpoint_path)
+    device = resolve_device(device_name)
+    checkpoint = torch.load(checkpoint_file, map_location=device, weights_only=False)
+    config = config_from_dict(checkpoint["config"])
+    if config.data.evaluation_protocol != "techjam_official":
+        raise ValueError("Checkpoint was not trained with the TechJam official evaluation protocol")
+    frame = load_scoring_interactions(config.data, input_csv)
+    encoder = _encoder_from_checkpoint(checkpoint)
+    encoded = torch.as_tensor(encoder.transform(frame), dtype=torch.long)
+    model = build_model(
+        config.model,
+        checkpoint["field_dims"],
+        task_count=1 + len(config.data.auxiliary_label_columns),
+    ).to(device)
+    model.load_state_dict(checkpoint["model_state_dict"])
+    model.eval()
+    predictions: list[np.ndarray] = []
+    for (features,) in DataLoader(TensorDataset(encoded), batch_size=batch_size, shuffle=False):
+        logits = model(features.to(device))
+        primary = logits[:, 0] if logits.ndim == 2 else logits
+        predictions.append(primary.cpu().numpy())
+    scores = np.concatenate(predictions)
+    if not np.isfinite(scores).all():
+        raise ValueError("Model produced NaN or Inf scores")
+
+    destination = Path(output_csv)
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    temporary = destination.with_suffix(destination.suffix + ".tmp")
+    output = pd.DataFrame(
+        {
+            "row_id": np.arange(len(frame), dtype=np.int64),
+            "user_id": frame[config.data.user_column].to_numpy(),
+            "video_id": frame[config.data.item_column].to_numpy(),
+            "score": scores,
+        }
+    )
+    output.to_csv(temporary, index=False, columns=OFFICIAL_HEADER)
+    temporary.replace(destination)
+    summary = {
+        "schema": OFFICIAL_HEADER,
+        "rows": len(output),
+        "checkpoint": str(checkpoint_file.resolve()),
+        "input": str(Path(input_csv).resolve()),
+        "output": str(destination.resolve()),
+        "sha256": _sha256(destination),
+        "label_columns_read": [],
+        "row_order_preserved": True,
+    }
+    destination.with_suffix(destination.suffix + ".meta.json").write_text(
+        json.dumps(summary, indent=2), encoding="utf-8"
+    )
+    return summary
+
+
+def validate_official_submission(path: str | Path, input_csv: str | Path) -> dict[str, Any]:
+    """Validate schema and alignment while intentionally never loading labels."""
+    expected = pd.read_csv(input_csv, usecols=["user_id", "video_id"])
+    actual = pd.read_csv(path)
+    if list(actual.columns) != OFFICIAL_HEADER:
+        raise ValueError(f"Header must be {','.join(OFFICIAL_HEADER)}")
+    if len(actual) != len(expected):
+        raise ValueError(f"Submission has {len(actual)} rows; expected {len(expected)}")
+    row_ids = actual["row_id"].to_numpy()
+    if not np.array_equal(row_ids, np.arange(len(expected))):
+        raise ValueError("row_id must be strictly increasing from zero without gaps")
+    if not np.array_equal(actual["user_id"].to_numpy(), expected["user_id"].to_numpy()):
+        raise ValueError("user_id values are not aligned with the evaluation split")
+    if not np.array_equal(actual["video_id"].to_numpy(), expected["video_id"].to_numpy()):
+        raise ValueError("video_id values are not aligned with the evaluation split")
+    scores = pd.to_numeric(actual["score"], errors="coerce").to_numpy()
+    if not np.isfinite(scores).all():
+        raise ValueError("score contains a non-numeric, NaN, or infinite value")
+    return {"status": "valid", "rows": len(actual), "sha256": _sha256(Path(path)), "labels_read": []}

